{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SocialNetwork.Api",
    "Audience": "SocialNetwork.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromEmail": "no-reply@socialnetwork.local",
    "FromName": "Social Network"
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "media",
    "PublicBaseUrl": ""
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "OpenApi": {
    "Enabled": false
  }
}
