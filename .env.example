# Скопіюйте цей файл у .env (він у .gitignore) і за потреби змініть значення.
# Використовується лише docker-compose для локальної розробки.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Потрібен лише для `docker compose --profile full` (API в контейнері). Мінімум 32 символи.
JWT_KEY=change-me-local-dev-key-at-least-32-characters
